{{- /*
MCP's objects in the ILM realm, for global.mcp.identity.mode managed. The keycloak-internal.realm helper appends each list
to the realm's and adds the ilm client's Username and Groups mappers to ilm-mcp-upstream.
*/ -}}
{{- $mcp := .Values.global.mcp }}
{{- $resource := printf "https://%s/mcp" (pluck "hostName" .Values.global .Values.ilm | compact | first) | toJson }}
{{- /* The group permission names the group by its id, so the id is fixed rather than generated by the import. */}}
{{- $groupId := "89dbe2d1-fbe2-418f-bcdc-19c11ec1448c" }}
{
  "adminPermissionsEnabled": true,
  {{- /*
  Not delegation:client: the realm file says Keycloak 24.0.2, so Keycloak 26.8's migration adds delegation:client and
  delegation:user here itself, and a second delegation:client entry rolls the whole import back.
  */}}
  "defaultOptionalClientScopes": [
    "mcp:access"
  ],
  "clientScopes": [
    {
      "name": "ilm-mcp-upstream",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "ilm-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ilm",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "mcp:access",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "mcp-exchange-requester",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ilm-mcp",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "mcp-public-resource",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": {{ $resource }},
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "delegation:client",
      "description": "OpenID Connect scope for agent/client token exchange delegation",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "parameterized.scope.type": "client-delegation",
        "display.on.consent.screen": "true",
        "always.display.consent": "true",
        "is.parameterized.scope": "true",
        "consent.screen.text": "${clientDelegationScopeConsentText}"
      },
      "protocolMappers": [
        {
          "name": "client delegation audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-parameterized-scope-audience-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "client may_act client_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-parameterized-scope-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "may_act.client_id",
            "jsonType.label": "String",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "client may_act sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-parameterized-scope-client-sub-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "may_act.sub",
            "jsonType.label": "String",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "admin-permissions",
      "authorizationSettings": {
        "policies": [
          {
            "name": "ilm-mcp-delegating-client",
            "type": "client",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "clients": "[\"ilm-mcp\"]"
            }
          },
          {{- if $mcp.delegation.group }}
          {
            "name": "ilm-mcp-selected-users-delegation",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "defaultResourceType": "Groups",
              "resources": "[\"{{ $groupId }}\"]",
              "scopes": "[\"delegate-members\"]",
              "applyPolicies": "[\"ilm-mcp-delegating-client\"]"
            }
          }
          {{- else }}
          {
            "name": "ilm-mcp-all-users-delegation",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "defaultResourceType": "Users",
              "resources": "[\"Users\"]",
              "scopes": "[\"delegate\"]",
              "applyPolicies": "[\"ilm-mcp-delegating-client\"]"
            }
          }
          {{- end }}
        ]
      }
    },
    {
      "clientId": "ilm-mcp",
      "surrogateAuthRequired": false,
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      {{- with $mcp.clientSecret }}
      "secret": {{ toJson . }},
      {{- end }}
      "redirectUris": [],
      "webOrigins": [],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "attributes": {
        "realm_client": "false",
        "backchannel.logout.session.required": "true",
        "standard.token.exchange.enabled": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "standard.token.exchange.enableRefreshRequestedTokenType": "NO"
      },
      "authenticationFlowBindingOverrides": {},
      "fullScopeAllowed": false,
      "nodeReRegistrationTimeout": -1,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "ilm-mcp-upstream",
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "clientProfiles": {
    "profiles": [
      {
        "name": "mcp-pkce",
        "executors": [
          {
            "executor": "pkce-enforcer",
            "configuration": {
              "auto-configure": true
            }
          }
        ]
      }
      {{- if $mcp.cimd.enabled }},
      {
        "name": "mcp-cimd",
        "executors": [
          {
            "executor": "client-id-metadata-document",
            "configuration": {
              "cimd-allow-permitted-domains": [
                "claude.ai",
                "localhost",
                "127.0.0.1"
              ],
              "accept-public-client-with-confidential-client-only-grant": true,
              "cimd-resource-indicator-allow-list": [
                {{ $resource }}
              ]
            }
          }
        ]
      }
      {{- end }}
    ]
  },
  "clientPolicies": {
    "policies": [
      {
        "name": "mcp-pkce",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-scopes",
            "configuration": {
              "scopes": [
                "mcp:access"
              ],
              "type": "Optional"
            }
          }
        ],
        "profiles": [
          "mcp-pkce"
        ]
      }
      {{- if $mcp.cimd.enabled }},
      {
        "name": "mcp-cimd",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-id-uri",
            "configuration": {
              "client-id-uri-scheme": [
                "https"
              ],
              "client-id-uri-allow-permitted-domains": [
                "claude.ai"
              ]
            }
          }
        ],
        "profiles": [
          "mcp-cimd"
        ]
      }
      {{- end }}
    ]
  },
  "groups": [
    {{- with $mcp.delegation.group }}
    {
      "id": "{{ $groupId }}",
      "name": {{ toJson . }},
      "path": {{ printf "/%s" . | toJson }},
      "subGroups": [],
      "attributes": {},
      "realmRoles": [],
      "clientRoles": {}
    }
    {{- end }}
  ]
}
